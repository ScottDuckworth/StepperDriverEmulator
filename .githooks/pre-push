#!/bin/sh
# Git pre-push hook: builds ARM Release firmware and validates flash/RAM sizing.
set -e

echo "=== [PRE-PUSH] Building ARM Release Firmware ==="
cmake --build --preset Release

echo "=== [PRE-PUSH] Checking Firmware Size Constraints ==="
if command -v python3 >/dev/null 2>&1; then
    PYTHON_CMD=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON_CMD=python
else
    echo "[ERROR] Python not found in PATH"
    exit 1
fi

$PYTHON_CMD scripts/check_firmware_size.py

echo "=== [PRE-PUSH] All pre-push checks passed ==="
