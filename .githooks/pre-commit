#!/bin/sh
# Git pre-commit hook: runs README validation and host unit tests.
set -e

echo "=== [PRE-COMMIT] Validating README.md ==="
if command -v python3 >/dev/null 2>&1; then
    PYTHON_CMD=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON_CMD=python
else
    echo "[ERROR] Python not found in PATH"
    exit 1
fi

$PYTHON_CMD scripts/validate_readme.py

echo "=== [PRE-COMMIT] Building & Running Host Unit Tests ==="
cmake --build --preset host-test
ctest --preset host-test --output-on-failure

echo "=== [PRE-COMMIT] Building ARM Release Firmware ==="
cmake --build --preset Release

echo "=== [PRE-COMMIT] Checking Disallowed Symbols (Float & Int64 Division) ==="
$PYTHON_CMD scripts/check_disallowed_symbols.py

echo "=== [PRE-COMMIT] Checking Firmware Size Constraints ==="
$PYTHON_CMD scripts/check_firmware_size.py

echo "=== [PRE-COMMIT] All presubmit checks passed ==="
